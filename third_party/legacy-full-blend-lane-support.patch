+"""Phase 1B.c D2 — LaneRunnerState + per-lane attn_groups clone helper.
+
+Owns the 22 canonical lane-local fields for one Green-Context lane
+(DECODE, PREP_slot_0, PREP_slot_1). Constructed at step 5 of the
+9-step init sequence (Codex D2 v5), bound to TLS at step 6, mutated
+by native ``execute_model`` / ``sample_tokens`` under
+``LaneStateField`` routing, and torn down on worker exit.
+
+Codex D2 v5 + Batch 1 hardening (2026-09-11):
+
+- Field names + order match
+  :data:`vllm.v1.worker._legacy_lane_state_fields.LANE_LOCAL_FIELDS`
+  exactly. Drift check compares the ordered dataclass-field tuple
+  directly (Codex Batch 1 — sets would let a reorder pass).
+- ``attn_groups`` clones use the AttentionGroup class's native
+  ``create_metadata_builders(vllm_config, device, kernel_block_size,
+  num_metadata_builders=1)`` method (Codex Batch 1 — real field
+  name is ``.backend``, and using the native factory keeps
+  block-size conversion, config, and device handling native).
+- ``layer_names`` is defensively copied (fresh list) so no builder
+  aliases the canonical.
+- ``close()`` is terminal + owner-thread-only + idempotent: it
+  detaches references (sets fields to ``None``) rather than
+  ``.clear()``-ing containers that could be aliased elsewhere.
+- V1 rejects ``parallel_config.use_ubatching`` (see boot guards);
+  ``num_metadata_builders`` is fixed at 1 here.
+"""
+
+from __future__ import annotations
+
+import threading
+from dataclasses import dataclass, field
+from typing import Any, List, Sequence, Tuple
+
+from vllm.v1.worker._legacy_lane_state_fields import (
+    LANE_LOCAL_FIELDS,
+    LaneStateAccessError,
+)
+
+
+# ``Any`` typing is deliberate — this module stays free of vLLM
+# imports so unit tests can construct ``LaneRunnerState`` locally
+# without a CUDA / vLLM install. Type comments below indicate the
+# runtime shape for reader guidance.
+
+
+@dataclass
+class LaneRunnerState:
+    """Per-lane mutable state owned by one worker thread.
+
+    Field order matches :data:`LANE_LOCAL_FIELDS`. Any drift between
+    the two is caught by ``__post_init__``'s ordered comparison.
+    """
+
+    lane_id: str
+
+    # Staging buffers (12; Codex v5 canonical).
+    input_ids: Any = None                     # PagedBuffer[int32]
+    positions: Any = None                     # torch.Tensor[int64]
+    query_start_loc: Any = None               # PagedBuffer[int32]
+    seq_lens: Any = None                      # torch.Tensor[int32]
+    optimistic_seq_lens_cpu: Any = None       # torch.Tensor[int32] (CPU)
+    num_computed_tokens: Any = None           # torch.Tensor[int32]
+    req_indices: Any = None                   # PagedBuffer[int64]
+    prev_positions: Any = None                # PagedBuffer[int64]
+    num_scheduled_tokens: Any = None          # PagedBuffer[int32]
+    query_pos: Any = None                     # PagedBuffer[int64]
+    discard_request_mask: Any = None          # PagedBuffer[bool]
+    num_accepted_tokens: Any = None           # PagedBuffer[int32]
+
+    # Output staging (2).
+    transfer_event: Any = None                # torch.cuda.Event
+    sampled_token_ids_pinned_cpu: Any = None  # pinned torch.Tensor
+
+    # Request-set state (4).
+    requests: dict = field(default_factory=dict)
+    num_prompt_logprobs: dict = field(default_factory=dict)
+    input_batch: Any = None                   # InputBatch
+    encoder_cache: dict = field(default_factory=dict)
+
+    # Execute -> sample handoff + connector output (2).
+    execute_model_state: Any = None
+    kv_connector_output: Any = None
+
+    # Mutable helpers (2).
+    late_interaction_runner: Any = None       # LateInteractionRunner instance
+    attn_groups: List[List[Any]] = field(default_factory=list)  # list[list[AttentionGroup]]
+
+    def __post_init__(self) -> None:
+        # Codex Batch 1 review — ordered comparison (not set):
+        # ``__dataclass_fields__`` preserves insertion order in
+        # Python 3.7+. Compare the tuple minus ``lane_id`` against
+        # ``LANE_LOCAL_FIELDS`` directly. A reorder is a drift and
+        # must fail loud.
+        ordered = tuple(
+            name
+            for name in self.__dataclass_fields__.keys()
+            if name != "lane_id"
+        )
+        if ordered != LANE_LOCAL_FIELDS:
+            raise TypeError(
+                f"LaneRunnerState field order drift:\n"
+                f"  declared: {ordered}\n"
+                f"  canonical: {LANE_LOCAL_FIELDS}"
+            )
+        # Terminal-close bookkeeping (owner thread + closed flag).
+        # Not dataclass fields (would show in drift check); regular
+        # instance attributes.
+        self._owner_thread_ident: int = threading.get_ident()
+        self._closed: bool = False
+
+    def close(self) -> None:
+        """Terminal, owner-thread-only, idempotent teardown.
+
+        Codex Batch 1 review: DETACH references (setattr None) rather
+        than clearing containers, because the canonical FULL owner
+        or another module may still hold aliases. After close, any
+        subsequent access via ``LaneStateField`` raises
+        :class:`LaneStateAccessError` (closed-state guard in the
+        descriptor).
+        """
+
+        if self._closed:
+            # Idempotent — double-close is a no-op.
+            return
+        if threading.get_ident() != self._owner_thread_ident:
+            raise LaneStateAccessError(
+                f"LaneRunnerState.close() called from thread "
+                f"{threading.get_ident()} but state is owned by "
+                f"thread {self._owner_thread_ident} (lane_id="
+                f"{self.lane_id!r}). close() is owner-thread-only."
+            )
+        for name in LANE_LOCAL_FIELDS:
+            # Detach: replace the reference on this state with None.
+            # Aliases held elsewhere are unaffected (Codex-required).
+            setattr(self, name, None)
+        self._closed = True
