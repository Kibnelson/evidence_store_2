+# --- Per-lane attn_groups clone helper -------------------------------
+#
+# Codex D2 v5 + Batch 1: "Copy layer_names, create fresh builders with
+# exact _kernel_block_sizes[group_id], and prove no builder identities
+# are shared." Use the AttentionGroup's native
+# ``create_metadata_builders`` so block-size conversion, config, and
+# device handling remain native. The nested ``create_attn_groups``
+# inside ``GPUModelRunner._create_attn_groups(...)`` at
+# ``gpu_model_runner.py:6748`` is not externally reachable; we clone
+# the constructed structure element-wise using the group class's
+# real field names + native builder factory.
+
+
+def clone_attn_groups_for_lane(
+    canonical: Sequence[Sequence[Any]],
+    *,
+    kernel_block_sizes: Sequence[Any],
+    vllm_config: Any,
+    device: Any,
+) -> List[List[Any]]:
+    """Return a lane-local ``list[list[AttentionGroup]]`` with fresh
+    metadata builders and defensively-copied ``layer_names``.
+
+    Parameters
+    ----------
+    canonical:
+        The FULL owner's ``GPUModelRunner.attn_groups`` after boot,
+        used purely as a shape + backend + spec + group_id source.
+        Never mutated.
+    kernel_block_sizes:
+        The FULL owner's ``_kernel_block_sizes`` list, indexed by
+        KV-cache group id. Each group id's block size is passed
+        verbatim into the native
+        ``AttentionGroup.create_metadata_builders(...)``.
+    vllm_config, device:
+        Passed through to the native
+        ``AttentionGroup.create_metadata_builders(...)`` so
+        block-size conversion, config handling, and device
+        placement remain native (Codex Batch 1 review).
+
+    Returns
+    -------
+    A list-of-lists mirroring ``canonical``'s shape. Each inner
+    ``AttentionGroup`` has:
+
+    - The SAME ``backend`` type reference (stateless strategy).
+    - The SAME ``kv_cache_spec`` reference (immutable).
+    - A defensively-copied ``layer_names`` list.
+    - Fresh metadata builders constructed via the group's native
+      ``create_metadata_builders``.
+    - The SAME ``kv_cache_group_id`` scalar.
+
+    Raises
+    ------
+    ValueError
+        If any ``AttentionGroup``'s ``kv_cache_group_id`` does not
+        match its outer index in ``canonical`` (Codex Batch 1
+        review — validate group IDs).
+    IndexError
+        If ``kernel_block_sizes`` is shorter than ``canonical``.
+    """
+
+    if len(kernel_block_sizes) < len(canonical):
+        raise IndexError(
+            f"kernel_block_sizes len={len(kernel_block_sizes)} < "
+            f"canonical len={len(canonical)}; cannot index group_id."
+        )
+
+    lane_groups: List[List[Any]] = []
+    for gid, canonical_group_list in enumerate(canonical):
+        lane_group_list: List[Any] = []
+        for ai, canonical_group in enumerate(canonical_group_list):
+            # Validate group IDs (Codex Batch 1).
+            declared_gid = getattr(canonical_group, "kv_cache_group_id", None)
+            if declared_gid != gid:
+                raise ValueError(
+                    f"AttentionGroup at ({gid}, {ai}) has "
+                    f"kv_cache_group_id={declared_gid!r}; expected {gid}."
+                )
+            lane_group_list.append(
+                _clone_attention_group(
+                    canonical_group,
+                    block_size=kernel_block_sizes[gid],
+                    vllm_config=vllm_config,
+                    device=device,
+                )
+            )
+        lane_groups.append(lane_group_list)
+    return lane_groups
+
+
+def _clone_attention_group(
+    canonical_group: Any,
+    *,
+    block_size: Any,
+    vllm_config: Any,
+    device: Any,
+) -> Any:
+    """Element-wise clone of one ``AttentionGroup``.
+
+    Uses the real field name ``.backend`` (Codex Batch 1 review;
+    v3/v4 mis-named this as ``.attn_backend``). Uses the group
+    class's native ``create_metadata_builders`` method so the
+    builder-construction path is byte-identical to the canonical
+    factory except for the fresh builder identity.
+    """
+
+    cls = type(canonical_group)
+    backend = canonical_group.backend
+    kv_cache_spec = canonical_group.kv_cache_spec
+    kv_cache_group_id = canonical_group.kv_cache_group_id
+    # Defensive layer_names copy — mutable list, could be aliased.
+    layer_names = list(canonical_group.layer_names)
+
+    # Construct with an empty ``metadata_builders`` slot, then let
+    # the native method populate it.
+    lane_group = cls(backend, layer_names, kv_cache_spec, kv_cache_group_id)
+    lane_group.create_metadata_builders(
+        vllm_config,
+        device,
+        kernel_block_size=block_size,
+        num_metadata_builders=1,  # V1 rejects ubatching at boot
+    )
+    return lane_group
+
+
+def assert_no_shared_builder_identities(
+    lane_groups_per_worker: Sequence[Sequence[Sequence[Any]]],
+) -> None:
+    """Sanity check for the concurrency test.
+
+    Given a sequence of ``lane_groups`` (one per worker), verifies
+    that no two workers hold the same metadata-builder identity
+    anywhere. Codex D2 v5 explicit: "prove no builder identities
+    are shared."
+    """
+
+    seen_ids: dict = {}
+    for wi, per_worker in enumerate(lane_groups_per_worker):
+        for gi, per_group in enumerate(per_worker):
+            for ai, attn_group in enumerate(per_group):
+                for bi, builder in enumerate(attn_group.metadata_builders):
+                    ident = id(builder)
+                    if ident in seen_ids:
+                        prior = seen_ids[ident]
+                        raise AssertionError(
+                            f"metadata_builder id={ident:#x} shared "
+                            f"between worker {prior[0]} group "
+                            f"({prior[1]},{prior[2]},{prior[3]}) and "
+                            f"worker {wi} group ({gi},{ai},{bi}). "
+                            f"Codex D2 v5 requires fresh builders "
+                            f"per lane."
+                        )
+                    seen_ids[ident] = (wi, gi, ai, bi)
