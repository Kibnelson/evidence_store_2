diff --git a/vllm/v1/worker/gpu/lifecycle.py b/vllm/v1/worker/gpu/lifecycle.py
new file mode 100644
index 0000000..e3f98e5
--- /dev/null
+++ b/vllm/v1/worker/gpu/lifecycle.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+from itertools import groupby
+
+import torch
+from evidencestore_lifecycle import emit
+
+from vllm.v1.worker.gpu.input_batch import InputBatch
+
+
+def emit_kv_writes(
+    step: int,
+    batch: InputBatch,
+    slot_mappings: torch.Tensor,
+    block_sizes: list[int],
+) -> None:
+    # This experiment fences the model stream before using a write receipt.
+    # Token spans come from the exact slot map submitted to attention.
+    torch.cuda.current_stream(slot_mappings.device).synchronize()
+    slots_by_group = slot_mappings[:, : batch.num_tokens].cpu().tolist()
+    positions = batch.positions[: batch.num_tokens].cpu().tolist()
+    for group, (slots, block_size) in enumerate(zip(slots_by_group, block_sizes)):
+        for request_index, request_id in enumerate(batch.req_ids):
+            lo, hi = batch.query_start_loc_np[request_index : request_index + 2]
+            for (block_id, _), span in groupby(
+                enumerate(slots[lo:hi], start=int(lo)),
+                key=lambda item: (item[1] // block_size, item[1] - item[0]),
+            ):
+                if block_id <= 0:
+                    continue
+                start, slot_start = next(span)
+                end, slot_end = start, slot_start
+                for end, slot_end in span:
+                    pass
+                emit(
+                    "vllm_gpu_kv_written",
+                    step=step,
+                    request_id=request_id,
+                    group=group,
+                    block_id=block_id,
+                    block_size=block_size,
+                    token_start=positions[start],
+                    token_end=positions[end] + 1,
+                    slot_start=slot_start,
+                    slot_end=slot_end + 1,
+                )
