diff --git a/lmcache/v1/lifecycle_trace.py b/lmcache/v1/lifecycle_trace.py
new file mode 100644
index 0000000..03b0f75
--- /dev/null
+++ b/lmcache/v1/lifecycle_trace.py
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Optional Evidence Store sink for the KV lifecycle checkout."""
+
+try:
+    import evidencestore_lifecycle as _sink
+except ModuleNotFoundError as exc:
+    if exc.name != "evidencestore_lifecycle":
+        raise
+    _sink = None
+
+
+def enabled() -> bool:
+    return _sink is not None and _sink.enabled()
+
+
+def emit(event: str, **data) -> None:
+    if _sink is not None:
+        _sink.emit(event, **data)
