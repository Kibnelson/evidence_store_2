+    def _strict_direct_io(
+        self,
+        file_path: Path,
+        buf: Union[bytearray, memoryview, bytes],
+        write: bool,
+    ) -> tuple[int, int, int]:
+        """Transfer one complete object with an O_DIRECT file descriptor."""
+        size = len(buf)
+        alignment = self._os_disk_bs
+        if (
+            size <= 0
+            or alignment <= 0
+            or size % alignment
+            or not _buffer_is_aligned(buf, alignment)
+        ):
+            raise OSError(errno.EINVAL, f"Unaligned direct I/O for {file_path.name}")
+
+        open_flags = os.O_CREAT | os.O_WRONLY | os.O_TRUNC if write else os.O_RDONLY
+        start_ns = time.monotonic_ns()
+        fd = os.open(file_path, open_flags | os.O_DIRECT, 0o644)
+        try:
+            fd_flags = fcntl.fcntl(fd, fcntl.F_GETFL)
+            if not fd_flags & os.O_DIRECT:
+                raise OSError(errno.EIO, "The file descriptor dropped O_DIRECT")
+            if write:
+                _write_full(fd, buf)
+                transferred = size
+            else:
+                view = memoryview(buf).cast("B")
+                transferred = 0
+                while transferred < size:
+                    count = os.readv(fd, [view[transferred:]])
+                    if count == 0:
+                        raise OSError(
+                            errno.EIO, f"Short direct read for {file_path.name}"
+                        )
+                    transferred += count
+        finally:
+            os.close(fd)
+        return transferred, fd_flags, time.monotonic_ns() - start_ns
+
